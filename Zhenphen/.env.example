# Copy to .env for LOCAL development only. Configure production values privately in Render.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://local_user:replace_me@localhost:5432/zhenphen_local
DATABASE_SSL=false
PG_POOL_SIZE=10
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://your-actual-service.onrender.com or approved custom domain.
# On Render only, RENDER_EXTERNAL_URL is supplied by the platform as a fallback.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=replace_me
EMAIL_SMTP_PASSWORD=replace_me
EMAIL_FROM=noreply@example.com
# Optional create-only administrator provisioning. Leave both email/password empty to disable.
SITE_ADMIN_EMAIL=
SITE_ADMIN_PASSWORD=
SITE_ADMIN_NAME=Zhenphen Administrator
SSU_ADMIN_EMAIL=
SSU_ADMIN_PASSWORD=
SSU_ADMIN_NAME=SSU Coordinator
